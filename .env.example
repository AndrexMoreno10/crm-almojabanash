# Variables opcionales. Se pueden exportar antes de npm run dev o npm start.
# El servidor usa loopback por defecto. No exponerlo a Internet sin autenticación.
PORT=3001
CRM_DATABASE_PATH=./data/crm.sqlite

# Meta / WhatsApp Cloud API. Déjalas vacías hasta crear y verificar la app.
# Configura los valores reales como secretos del servidor; no los subas a Git.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
META_SEND_ENABLED=false
